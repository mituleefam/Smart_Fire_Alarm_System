        "name": "Xét ngưỡng",
        "func": "// fn_xet_nguong.js\nconst TEMP_ALARM = 45;   // độ C; 50 là giới hạn đo của DHT11\n\nconst p = msg.payload;\nlet text = null;\nif (msg.topic.endsWith('/smoke') && p.level === 'DANGER') {\n    text = `CẢNH BÁO KHÓI: ${p.mv} mV`;\n} else if (msg.topic.endsWith('/dht') && p.t >= TEMP_ALARM) {\n    text = `CẢNH BÁO NHIỆT ĐỘ: ${p.t} °C`;\n}\nif (!text) return null;  // không nguy hiểm thì dừng tại đây\nmsg.payload = text;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
